# Copie este arquivo para ".env" e preencha. O ".env" nunca é enviado ao GitHub.

# ---------- Life Dashboard ----------
# Porta do painel. Abra http://localhost:4310 no navegador.
PORT=4310
# 127.0.0.1 = só este computador. Para acessar pelo iPhone/Mac na rede de casa,
# use 0.0.0.0 E defina ACCESS_TOKEN (o sistema se recusa a abrir na rede sem token).
HOST=127.0.0.1
# Senha de acesso (texto longo e aleatório). Obrigatória se HOST não for 127.0.0.1.
ACCESS_TOKEN=
# Fuso horário usado para "hoje", semanas e prazos.
TIMEZONE=America/Sao_Paulo

# Onde ficam o banco de dados e os backups (caminhos relativos à pasta do projeto ou absolutos).
DATA_DIR=./data
BACKUP_DIR=./backups
# Backup automático diário enquanto o painel estiver aberto, mantendo os N mais recentes.
AUTO_BACKUP=true
BACKUP_KEEP=30

# ---------- Obsidian ----------
# Caminho completo da pasta do seu vault. Exemplos:
#   Windows: C:\Users\SeuNome\Documents\Vault
#   WSL:     /mnt/c/Users/SeuNome/Documents/Vault
#   Mac:     /Users/seunome/Documents/Vault
OBSIDIAN_VAULT_PATH=

# ---------- Jarvis ----------
# Endereço do painel usado pelo servidor MCP (Hermes). Normalmente não precisa mudar.
JARVIS_API_URL=http://127.0.0.1:4310
# true = o Jarvis só consulta, nunca grava (bom para testar o Hermes com segurança).
JARVIS_READONLY=false

# Modo básico do Telegram (sem IA, comandos /hoje /tarefa /ideia ...).
# Deixe vazio se for usar o Hermes Agent. NÃO use o mesmo bot nos dois.
JARVIS_TELEGRAM_BOT_TOKEN=
# Seu ID numérico do Telegram (peça ao @userinfobot). Vários: separe por vírgula.
JARVIS_TELEGRAM_ALLOWED_USERS=
